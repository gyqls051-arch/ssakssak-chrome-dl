{
  "manifest_version": 3,
  "name": "싹싹김치",
  "version": "1.0.1",
  "description": "웹 페이지에서 재생 중인 영상 스트림(HLS 등)을 감지해 다운로드합니다. 다운로드 권한이 있는 콘텐츠에만 사용하세요.",

  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "offscreen"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "싹싹김치",
    "default_icon": {
      "16": "icons/brand/app-16.png",
      "32": "icons/brand/app-32.png",
      "48": "icons/brand/app-48.png",
      "128": "icons/brand/app-128.png"
    }
  },

  "options_page": "options.html",

  "icons": {
    "16": "icons/brand/app-16.png",
    "32": "icons/brand/app-32.png",
    "48": "icons/brand/app-48.png",
    "128": "icons/brand/app-128.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtu.be/*"],
      "js": ["inject.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
